# Include a .env.dev & .env.prod to use the run.sh script

# Docker Compose project name (keeps container/volume names consistent)
COMPOSE_PROJECT_NAME=lesson-organizer

# Frontend API URL
# - Development: Set to http://localhost:4000 for local dev
# - Production: Can be omitted (auto-detected) or set to https://your-domain.com
#   When using Caddy reverse proxy, the frontend auto-detects same-origin API requests
VITE_API_BASE_URL=http://<local-ip>:4000

# Tailscale authentication key
# - Only needed if using Tailscale deployment (compose.prod.tailscale.yml)
# - Not required for standard production or local development
# - Get from: https://login.tailscale.com/admin/settings/keys
TS_AUTH_KEY=<your-tailscale-auth-key>

# Cloudflare API Token
# - Only needed for production deployments using Caddy with Cloudflare DNS
# - Required for automatic SSL certificate generation via DNS-01 challenge
# - Not needed for local development
# CLOUDFLARE_API_TOKEN=<your-cloudflare-api-token>

# Admin user credentials (created on first startup)
ADMIN_FIRST_NAME=<first-name-of-admin>
ADMIN_LAST_NAME=<last-name-of-admin>
ADMIN_EMAIL=<email-address-of-admin>
ADMIN_PASSWORD=<password-for-admin>

# Security secrets (generate with: python3 -c "import secrets; print(secrets.token_hex(32))")
# IMPORTANT: Generate unique values for each environment (dev, staging, production)
# These are required in all environments and must be kept secret
SECRET_KEY=<generate-strong-secret>
JWT_SECRET_KEY=<generate-strong-secret>
SECURITY_PASSWORD_SALT=<generate-strong-secret>
